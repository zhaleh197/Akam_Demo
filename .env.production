# Settings of the deployed site (Vercel builds with `vite build`, which reads
# this file). Public values only - anything here ends up in the site's code.

# The KYC server: scripts/public_demo.py in the kyc project, reached through
# its fixed ngrok address. That server must list this site's origin in
# KYC_CORS_ORIGINS (public_demo.py --cors https://<site>.vercel.app).
VITE_KYC_API_URL=https://privatize-plutonium-irregular.ngrok-free.dev
